{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"inlineContent":[{"text":"Swiftuna","type":"text"}],"type":"strong"},{"text":" brings production-grade Bayesian hyperparameter optimization (HPO) directly to the Swift ecosystem. It embeds Rustuna (","type":"text"},{"type":"codeVoice","code":"rustuna_core"},{"text":") with zero runtime overhead over a C ABI bridge, delivering pure native Swift ergonomics and 97-104 ms latency per 1,000 trials—matching or exceeding pure Rust performance.","type":"text"}],"type":"paragraph"},{"text":"Quickstart","type":"heading","level":3,"anchor":"Quickstart"},{"type":"codeListing","syntax":"swift","code":["import Swiftuna","","\/\/ 1. Create a study","let study = try Swiftuna.createStudy(","    name: \"quickstart_study\",","    direction: .minimize",")","","\/\/ 2. Run optimization","try study.optimize(nTrials: 100) { trial in","    let x = try trial.suggest(\"x\", in: -10.0...10.0)","    let y = try trial.suggest(\"y\", in: 0...5)","    return (x - 2.0) * (x - 2.0) + Double(y)","}","","\/\/ 3. Retrieve best trial","let best = try study.bestTrial","print(\"Optimal x: \\(best?.params[\"x\"] ?? 0.0), value: \\(try study.bestValue)\")"]}],"kind":"content"}],"metadata":{"externalID":"Swiftuna","modules":[{"name":"Swiftuna"}],"roleHeading":"Framework","role":"collection","title":"Swiftuna","symbolKind":"module"},"topicSections":[{"identifiers":["doc:\/\/Swiftuna\/documentation\/Swiftuna\/Study","doc:\/\/Swiftuna\/documentation\/Swiftuna\/Trial","doc:\/\/Swiftuna\/documentation\/Swiftuna\/PersistedTrial","doc:\/\/Swiftuna\/documentation\/Swiftuna\/Direction","doc:\/\/Swiftuna\/documentation\/Swiftuna\/TrialState"],"title":"Optimization Engine","anchor":"Optimization-Engine"},{"identifiers":["doc:\/\/Swiftuna\/documentation\/Swiftuna\/createStudy(name:directions:storage:sampler:pruner:loadIfExists:)","doc:\/\/Swiftuna\/documentation\/Swiftuna\/createStudy(name:direct